# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/crm_db

# ─── JWT Auth ────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── Groq AI (free at console.groq.com) ─────────────────────────────────────
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Gmail SMTP ──────────────────────────────────────────────────────────────
# Enable 2FA → myaccount.google.com → Security → App Passwords → create "Mail"
GMAIL_USER=yourname@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ─── Telegram Bot ────────────────────────────────────────────────────────────
# 1. Message @BotFather → /newbot → get TOKEN
# 2. Add bot to group/channel as admin
# 3. GET https://api.telegram.org/bot{TOKEN}/getUpdates → copy chat.id
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ0123456789
TELEGRAM_CHAT_ID=-1001234567890
